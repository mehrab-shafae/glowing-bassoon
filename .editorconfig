root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[**/*.{c,cpp,cc,h,hpp,rs,py,sh}]
indent_size = 4

[**/*.{js,ts,json}]
indent_size = 2

[**/*.yml]
indent_size = 2

[**/CMakeLists.txt]
indent_size = 2

[**/*.cmake]
indent_size = 2

[**/*.cmake.in]
indent_size = 2

[**/Makefile]
indent_style = tab
trim_trailing_whitespace = false

[**/*.md]
trim_trailing_whitespace = false
insert_final_newline = true
