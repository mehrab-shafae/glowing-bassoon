set(CMAKE_C_FLAGS_INIT   "${CMUSL_CFLAGS} ${CMUSL_LTOFLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${CMUSL_CXXFLAGS} ${CMUSL_LTOFLAGS}")

set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -static -static-libgcc -static-libstdc++ ${CMAKE_C_FLAGS_INIT}")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -static -static-libgcc -static-libstdc++ ${CMAKE_CXX_FLAGS_INIT}")
set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -g -O0 -DDEBUG")

set(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} ${CMAKE_C_FLAGS}")
set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} ${CMAKE_CXX_FLAGS}")

set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -static -static-libgcc -static-libstdc++ ${CMUSL_LDFLAGS} ${CMUSL_LTOFLAGS}")
set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} ${CMUSL_LDFLAGS} ${CMUSL_LTOFLAGS}")
set(CMAKE_MODULE_LINKER_FLAGS "${CMAKE_MODULE_LINKER_FLAGS} ${CMUSL_LDFLAGS} ${CMUSL_LTOFLAGS}")

if(NOT "${CMUSL_LTOFLAGS}" STREQUAL "")
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION TRUE)
endif()

